<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>SqlCockpit.Connection</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Connection</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>PortalUrl</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Email</Label></TableColumnHeader>
          <TableColumnHeader><Label>ApiKeyName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Checked</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>PortalUrl</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Email</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ApiKeyName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Checked</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.Account</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Account</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>Email</PropertyName></ListItem>
              <ListItem><PropertyName>EmailVerified</PropertyName></ListItem>
              <ListItem><Label>Plan</Label><ScriptBlock>$_.Plan.Name</ScriptBlock></ListItem>
              <ListItem><Label>Subscription</Label><ScriptBlock>if ($_.Subscription) { '{0} ({1})' -f $_.Subscription.Status, $_.Subscription.Cycle }</ScriptBlock></ListItem>
              <ListItem><PropertyName>BillingAccount</PropertyName></ListItem>
              <ListItem><PropertyName>TeamMember</PropertyName></ListItem>
              <ListItem><Label>ConnectedVia</Label><ScriptBlock>if ($_.ConnectedVia) { '{0} {1}' -f $_.ConnectedVia.Type, $_.ConnectedVia.Name }</ScriptBlock></ListItem>
              <ListItem><Label>Scopes</Label><ScriptBlock>if ($_.ConnectedVia) { $_.ConnectedVia.Scopes -join ', ' }</ScriptBlock></ListItem>
              <ListItem><PropertyName>PortalUrl</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>SqlCockpit.UsageAllowance</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.UsageAllowance</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Label</Label></TableColumnHeader>
          <TableColumnHeader><Label>Used</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Limit</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Remaining</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>AtLimit</Label></TableColumnHeader>
          <TableColumnHeader><Label>Plan</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Label</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Used</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Unlimited) { 'unlimited' } elseif ($_.Included -eq $false) { 'not included' } else { $_.Limit }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Remaining</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AtLimit</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Plan</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.ApiKey</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.ApiKey</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ApiKeyId</Label><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>EndsWith</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExpiresAt</Label></TableColumnHeader>
          <TableColumnHeader><Label>LastUsedAt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ApiKeyId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EndsWith</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExpiresAt</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LastUsedAt</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.Tenant</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Tenant</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>TenantId</Label></TableColumnHeader>
          <TableColumnHeader><Label>YourRole</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Agents</Label><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>YourRole</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AgentsCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.TeamMember</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.TeamMember</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Email</Label></TableColumnHeader>
          <TableColumnHeader><Label>Role</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>MembershipId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Email</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Role</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MembershipId</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.Team</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Team</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>TenantName</PropertyName></ListItem>
              <ListItem><PropertyName>TenantId</PropertyName></ListItem>
              <ListItem><Label>Owner</Label><ScriptBlock>if ($_.Owner) { '{0} &lt;{1}&gt;' -f $_.Owner.Name, $_.Owner.Email }</ScriptBlock></ListItem>
              <ListItem><Label>Members</Label><ScriptBlock>@($_.Members).Count</ScriptBlock></ListItem>
              <ListItem><PropertyName>YouCanManage</PropertyName></ListItem>
              <ListItem><Label>AssignableRoles</Label><ScriptBlock>$_.AssignableRoles -join ', '</ScriptBlock></ListItem>
              <ListItem><Label>Seats</Label><ScriptBlock>if ($_.Seats) { if ($null -eq $_.Seats.Limit) { '{0} used, no limit' -f $_.Seats.Used } else { '{0} of {1}' -f $_.Seats.Used, $_.Seats.Limit } }</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>SqlCockpit.TeamMemberRemoval</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.TeamMemberRemoval</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Removed</Label></TableColumnHeader>
          <TableColumnHeader><Label>Email</Label></TableColumnHeader>
          <TableColumnHeader><Label>MembershipId</Label></TableColumnHeader>
          <TableColumnHeader><Label>TenantId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Removed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Email</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MembershipId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.TeamMemberInvite</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.TeamMemberInvite</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Sent</Label></TableColumnHeader>
          <TableColumnHeader><Label>Email</Label></TableColumnHeader>
          <TableColumnHeader><Label>MembershipId</Label></TableColumnHeader>
          <TableColumnHeader><Label>TenantId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Sent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Email</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MembershipId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.Agent</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Agent</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Hostname</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Connection</Label></TableColumnHeader>
          <TableColumnHeader><Label>TenantName</Label></TableColumnHeader>
          <TableColumnHeader><Label>LastSeenAt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Hostname</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Connection</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TenantName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LastSeenAt</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.Instance</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.Instance</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Hostname</Label></TableColumnHeader>
          <TableColumnHeader><Label>HostingMode</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Revision</Label></TableColumnHeader>
          <TableColumnHeader><Label>TenantName</Label></TableColumnHeader>
          <TableColumnHeader><Label>LastSeenAt</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Hostname</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HostingMode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0}/{1}' -f $_.AppliedRevision, $_.Revision</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>TenantName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LastSeenAt</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>SqlCockpit.SupportTicketDetail</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.SupportTicketDetail</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>TicketId</PropertyName></ListItem>
              <ListItem><PropertyName>Subject</PropertyName></ListItem>
              <ListItem><PropertyName>Status</PropertyName></ListItem>
              <ListItem><PropertyName>Priority</PropertyName></ListItem>
              <ListItem><PropertyName>TenantName</PropertyName></ListItem>
              <ListItem><PropertyName>AgentName</PropertyName></ListItem>
              <ListItem><PropertyName>CreatedAt</PropertyName></ListItem>
              <ListItem><PropertyName>UpdatedAt</PropertyName></ListItem>
              <ListItem><PropertyName>Message</PropertyName></ListItem>
              <ListItem><PropertyName>TeamResponse</PropertyName></ListItem>
              <ListItem><Label>Replies</Label><ScriptBlock>@($_.Replies).Count</ScriptBlock></ListItem>
              <ListItem><PropertyName>PortalUrl</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>SqlCockpit.SupportTicket</Name>
      <ViewSelectedBy><TypeName>SqlCockpit.SupportTicket</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Subject</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Priority</Label></TableColumnHeader>
          <TableColumnHeader><Label>UpdatedAt</Label></TableColumnHeader>
          <TableColumnHeader><Label>TicketId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Priority</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UpdatedAt</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TicketId</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
